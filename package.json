{
  "name": "roomdhundo",
  "version": "1.0.0",
  "description": "Roomdhundo - Property & PG Accommodation Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/supabase-client-init.test.js tests/supabase-services.test.js tests/auth-system.test.js",
    "build:css": "npm run build:css:public && npm run build:css:owner && npm run build:css:user && npm run build:css:admin && npm run build:css:enquiries",
    "build:css:public": "npx @tailwindcss/cli -i files6.0/src/style.input.css -o files6.0/style.css --minify",
    "build:css:owner": "npx @tailwindcss/cli -i files6.0/src/owner.input.css -o files6.0/owner-dashboard.css --minify",
    "build:css:user": "npx @tailwindcss/cli -i files6.0/src/user.input.css -o files6.0/user-dashboard.css --minify",
    "build:css:admin": "npx @tailwindcss/cli -i files6.0/src/admin.input.css -o files6.0/admin.css --minify",
    "build:css:enquiries": "npx @tailwindcss/cli -i files6.0/src/enquiries.input.css -o files6.0/user-enquiries.css --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rupammajumder0018-netizen/roomdhundo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "5.4.21"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  }
}
